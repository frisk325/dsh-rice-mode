{
  "name": "dsh-rice-mode",
  "version": "1.1.0",
  "type": "module",
  "main": "index.js",
  "description": "无限大白饭模式：三档切换（关/本轮/常开），按会话隔离。0=关 1=本轮 2=一直开。",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness"
  ],
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": "./client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "install": {
    "preferred": "tarball",
    "tarball": "https://github.com/frisk325/dsh-rice-mode/archive/refs/heads/main.tar.gz",
    "zip": "https://github.com/frisk325/dsh-rice-mode/archive/refs/heads/main.zip",
    "git": "https://github.com/frisk325/dsh-rice-mode.git"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frisk325/dsh-rice-mode.git"
  },
  "homepage": "https://github.com/frisk325/dsh-rice-mode#readme",
  "bugs": {
    "url": "https://github.com/frisk325/dsh-rice-mode/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
